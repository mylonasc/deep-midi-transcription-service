# Host HuggingFace hub directory, mounted read-only by Compose.
# MUSCRIPTOR_CACHE_DIR=/home/your-user/.cache/huggingface/hub

# Paths below are INSIDE the API container. Include sibling config.json.
# Leave empty to use muscriptor's default download/cache behavior for that size.
MUSCRIPTOR_WEIGHTS_SMALL=
MUSCRIPTOR_WEIGHTS_MEDIUM=
MUSCRIPTOR_WEIGHTS_LARGE=
# Example medium path (replace REVISION with your cached snapshot revision):
# MUSCRIPTOR_WEIGHTS_MEDIUM=/models/huggingface/models--MuScriptor--muscriptor-medium/snapshots/REVISION/model.safetensors
