# Host HuggingFace hub directory, mounted read-only by Compose.
# MUSCRIPTOR_CACHE_DIR=/home/your-user/.cache/huggingface/hub

# Paths below are INSIDE the API container. Include sibling config.json.
# Leave empty to use muscriptor's default download/cache behavior for that size.
MUSCRIPTOR_WEIGHTS_SMALL=
MUSCRIPTOR_WEIGHTS_MEDIUM=
MUSCRIPTOR_WEIGHTS_LARGE=
# Example medium path (replace REVISION with your cached snapshot revision):
# MUSCRIPTOR_WEIGHTS_MEDIUM=/models/huggingface/models--MuScriptor--muscriptor-medium/snapshots/REVISION/model.safetensors

# Open-Fret: operator opt-in, no weights bundled. Resolve upstream rights caveats
# before redistribution/commercial use. Keep revision pinned, not a branch name.
OPEN_FRET_MODEL_REVISION=b8edf84f4b76a8bc03bc1d78255c77364fba72eb
OPEN_FRET_ALLOW_DOWNLOAD=false
# A local model directory must include MODEL_REVISION containing the commit above,
# model.safetensors, config.json, tokenizer.json and tokenizer_config.json.
# Use a container-visible path, e.g. under the /models/huggingface mount.
OPEN_FRET_MODEL_DIR=
OPEN_FRET_TIMEOUT_S=300
OPEN_FRET_MAX_NOTES=20000
